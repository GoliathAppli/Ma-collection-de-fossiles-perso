    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "idb-keyval": "^6.2.5",
    "lucide-react": "^0.546.0",
    "megajs": "^1.3.10",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-player": "^3.4.0",
    "vite": "^6.2.3",
    "vite-plugin-node-polyfills": "^0.28.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-legacy": "^8.0.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.12",
    "sharp": "^0.35.4",
    "shx": "^0.4.0",
    "tailwindcss": "^4.1.14",
